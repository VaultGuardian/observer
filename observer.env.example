# VaultGuardian Observer environment
# This file contains API keys and runtime configuration.
# Permissions: 0600 (root only). Do not chmod world-readable.

# Core
DATA_DIR=/var/lib/observer
DASHBOARD_PORT=9090

# Server identity (shown in alert emails).
HOSTNAME=

# Dashboard binding. Local only.
#
# The hosted dashboard does NOT need this changed: Observer reaches it
# outbound after pairing (see SYNC_* below), so nothing connects in and
# there is no port to open. Override this only to serve the local API to
# your own LAN or to a reverse proxy on this box, and put TLS and
# authentication in front of it if you do.
DASHBOARD_BIND_ADDR=127.0.0.1

# Dashboard CORS allowlist (comma-separated origins). Empty = no CORS headers.
# Set this if a browser-side dashboard hits Observer directly.
DASHBOARD_ALLOWED_ORIGINS=

# LLM
LLM_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=

# Sources
DOCKER_SOCKET=/var/run/docker.sock
# Set false only if this host has no journald.
JOURNALD_ENABLED=true
EXCLUDE_CONTAINERS=

# Evidence capture
REC_ENABLED=true

# Proxy topology instrumentation (optional). Comma-separated names of the
# edge source(s) that generate the trusted per-request ID (vgrid). Empty =
# off, and uninstrumented behavior is unchanged. When set, one HTTP request
# logged by both the edge proxy and the backend coalesces into a single
# finding when timing and routing permit; notification count can differ. Correlation
# happens only through the trusted ID (no timing/shape heuristics). See the
# README "Proxy topology instrumentation" section for the nginx/Apache setup.
#LINEAGE_ANCHOR_SOURCES=captain-nginx

# Normalizer shape profiles (optional). JSON object mapping a source key to a
# declared log grammar, for sources whose name does not identify their format -
# a reverse proxy called edge/router/gateway emitting combined access logs
# otherwise falls to the generic normalizer and reuses poorly. Keys are
# "source_type:source_name" or a bare "source_name". One profile name is
# available: http-combined-v1. It is strict - a line that does not satisfy the
# whole grammar is normalized by the usual selection chain instead, unchanged.
# A malformed document or an unknown profile name stops startup. Empty = off,
# and normalization is unchanged. See docs/configuration.md.
#
# Keep the single quotes: systemd reads this file as an EnvironmentFile, and
# the JSON value carries double quotes and commas.
#NORMALIZER_HINTS_JSON='{"docker:edge":"http-combined-v1","router":"http-combined-v1"}'

# Email alerts (optional). Uncomment and fill in all three to enable.
#RESEND_API_KEY=
#ALERT_EMAIL_TO=
#ALERT_EMAIL_FROM=

# ---------------------------------------------------------------------------
# Hosted dashboard sync (optional)
# ---------------------------------------------------------------------------
# Only for users of the hosted VaultGuardian dashboard. Self-hosters leave
# every SYNC_* variable unset: with SYNC_URL/SYNC_TOKEN absent no sync code
# runs at all, and Observer behaves exactly as it always has.
#
# Normally you do not hand-edit these: `vaultguardian pair --url https://vaultguardian.io <code>` claims a
# pairing code from the dashboard and writes SYNC_URL and SYNC_TOKEN here
# along with the command-channel values further down.
#
# Both variables must be set for sync to activate. Setting only one logs a
# warning and leaves sync disabled.
#
# SYNC_URL must be https. Plain http is rejected at startup (sync disabled)
# unless the host is localhost/127.0.0.1, which exists for local development.
#
# UNSUPPORTED: restoring or deleting observer.db while keeping the same
# SYNC_TOKEN. The sync cursors live inside that database; if the database goes
# backwards relative to them, Observer fails closed - it refuses to sync and
# logs why on every startup - because new local rows would reuse row ids from
# the abandoned timeline and overwrite unrelated rows on the hosted mirror.
# Re-pair the instance with a fresh token instead.
#
#SYNC_URL=https://vaultguardian.io
#SYNC_TOKEN=

# Sync cadences. Defaults are fine for nearly everyone.
#SYNC_INTERVAL=15s            # findings + decisions
#SYNC_SNAPSHOT_INTERVAL=5m    # stats, patterns, trusted IPs, REC coverage
#SYNC_HEARTBEAT_INTERVAL=60s  # liveness only

# ---------------------------------------------------------------------------
# Hosted command channel (written by 'vaultguardian pair' - do not hand-edit)
# ---------------------------------------------------------------------------
# These three values are provisioned by `vaultguardian pair --url https://vaultguardian.io <code>`, which
# claims a pairing code from the hosted dashboard and rewrites this file in
# place. Editing them by hand will at best disable the channel and at worst
# leave this Observer executing commands from a stale pairing session.
#
# With any of them missing or invalid, Observer logs one line at startup and
# runs the outbound sync lanes exactly as before - the command channel simply
# stays dark.
#
#   SYNC_INSTANCE_ID   this instance's hosted UUID; part of every signed
#                      command tuple, so a command minted for another box
#                      cannot verify here.
#   SYNC_VERIFY_KEY    base64 Ed25519 PUBLIC key (exactly 32 bytes decoded).
#                      Commands are signed by the hosted control plane with
#                      the matching private key, which lives in its
#                      environment and never in its database - so a database
#                      compromise cannot mint or alter commands.
#   SYNC_COMMAND_EPOCH opaque pairing-session id. It rotates on re-pair;
#                      commands carrying an older epoch are rejected instead
#                      of executed late.
#
#SYNC_INSTANCE_ID=
#SYNC_VERIFY_KEY=
#SYNC_COMMAND_EPOCH=

# How often Observer polls for pending commands. Default 30s.
#SYNC_COMMAND_INTERVAL=30s
